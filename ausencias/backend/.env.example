# Copie este arquivo para ".env" (na mesma pasta) e ajuste se necessário.
# Formato: postgresql+psycopg://USUARIO:SENHA@SERVIDOR:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql+psycopg://ausencias:ausencias@localhost:5432/ausencias

# Banco separado usado pelo teste automático (test_flow.py). Ele é apagado e recriado a cada execução.
TEST_DATABASE_URL=postgresql+psycopg://ausencias:ausencias@localhost:5432/ausencias_test
